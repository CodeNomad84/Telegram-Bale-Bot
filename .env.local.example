# الگوی فایل .env — این فایل را به نام .env کپی کنید و مقادیر واقعی را وارد کنید.
# فایل .env هرگز نباید commit شود (در .gitignore است).

# توکن ربات از @BotFather در بله
BALE_TOKEN=123456789:your-bale-bot-token

# نام کاربری ربات (برای ساخت لینک دعوت)
BOT_USERNAME=@your_bot_username

# شناسه یا نام کاربری کانال عضویت اجباری (خالی = بدون بررسی عضویت)
CHANNEL_ID=@your_channel

# لینک عضویت کانال
CHANNEL_LINK=https://ble.ir/join/your-invite-code

# شناسه عددی ادمین‌ها، با کاما جدا شود
ADMIN_IDS=111111111,222222222
